# Copy to .env and change every value before the first start.
NEXORA_DB_PASSWORD=change-me-db
NEXORA_S3_ACCESS_KEY=nexora
NEXORA_S3_SECRET_KEY=change-me-s3-secret
NEXORA_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
# Signs Office editor sessions. Use a long random string, e.g. `openssl rand -hex 32`.
NEXORA_WOPI_TOKEN_SECRET=change-me-to-a-long-random-string
# Collabora admin console: http://localhost:9980/browser/dist/admin/admin.html
NEXORA_OFFICE_ADMIN_PASSWORD=change-me-office

# Optional.
# Creates users alice/bob and an "Intranet" site on first start:
NEXORA_DEMO_DATA=true
NEXORA_HTTP_PORT=8088
# Host:port browsers use to reach the Office editor, and which pages may embed it:
NEXORA_OFFICE_PUBLIC_HOST=localhost:9980
NEXORA_OFFICE_FRAME_ANCESTORS=localhost:*
# Set to true when NEXORA is served over HTTPS:
NEXORA_SECURE_COOKIES=false
