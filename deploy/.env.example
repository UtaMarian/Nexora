# Copy to .env and change every value before the first start. Generate secrets with: openssl rand -hex 24

# ---- public address: host[:port] users type in the browser (certificates must match it) ----
NEXORA_PUBLIC_HOST=localhost:8443
NEXORA_HTTPS_PORT=8443
NEXORA_HTTP_PORT=8088

# ---- NEXORA ----
NEXORA_DB_PASSWORD=change-me-db
NEXORA_S3_ACCESS_KEY=nexora
NEXORA_S3_SECRET_KEY=change-me-s3-secret
# Local break-glass administrator ("admin"); set NEXORA_LOCAL_LOGIN=false to allow only directory sign-in
NEXORA_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
NEXORA_LOCAL_LOGIN=true
# Desktop Office sign-in: basic = Windows prompt (allow the host in Office's Basic-prompt policy, see docs/identity.md),
# forms = NEXORA sign-in window with single sign-on
NEXORA_OFFICE_SIGN_IN=basic
# Encrypts stored SharePoint migration credentials. Keep it stable; if empty, the WOPI token secret is used.
NEXORA_ADMIN_SECRET=
NEXORA_WOPI_TOKEN_SECRET=change-me-to-a-long-random-string
NEXORA_OFFICE_ADMIN_PASSWORD=change-me-office
NEXORA_DEMO_DATA=true

# ---- Keycloak (sign-in) ----
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
NEXORA_OIDC_CLIENT_SECRET=change-me-oidc-client
NEXORA_SYNC_CLIENT_SECRET=change-me-sync-client
# Members of this directory group become NEXORA administrators
NEXORA_ADMIN_GROUP=NEXORA Admins
NEXORA_OIDC_DISPLAY_NAME=Organization account

# ---- Active Directory / LDAP (leave LDAP_URL empty for none) ----
# Active Directory example:
#   LDAP_URL=ldaps://dc01.corp.example.com:636
#   LDAP_VENDOR=ad
#   LDAP_BIND_DN=CN=svc-nexora,OU=Service Accounts,DC=corp,DC=example,DC=com
#   LDAP_BIND_PASSWORD=...
#   LDAP_USERS_DN=OU=Staff,DC=corp,DC=example,DC=com
#   LDAP_GROUPS_DN=OU=Groups,DC=corp,DC=example,DC=com
# Built-in demo directory (no domain controller needed):
COMPOSE_PROFILES=demo-directory
LDAP_URL=ldap://ldap:389
LDAP_VENDOR=other
LDAP_BIND_DN=cn=admin,dc=corp,dc=nexora,dc=test
LDAP_BIND_PASSWORD=change-me-ldap
LDAP_USERS_DN=ou=People,dc=corp,dc=nexora,dc=test
LDAP_GROUPS_DN=ou=Groups,dc=corp,dc=nexora,dc=test

# ---- Kerberos single sign-on (optional; needs AD, an SPN and deploy/keycloak/nexora.keytab) ----
# e.g. KERBEROS_REALM=CORP.EXAMPLE.COM
#      KERBEROS_PRINCIPAL=HTTP/nexora.corp.example.com@CORP.EXAMPLE.COM
#      KEYCLOAK_JAVA_OPTS=-Djava.security.krb5.conf=/opt/keycloak/conf/nexora/krb5.conf
KERBEROS_REALM=
KERBEROS_PRINCIPAL=
KEYCLOAK_JAVA_OPTS=

# ---- ADFS (optional) ----
# Federation metadata of your ADFS, e.g. https://adfs.corp.example.com/FederationMetadata/2007-06/FederationMetadata.xml
ADFS_METADATA_URL=
ADFS_ALIAS=adfs
ADFS_DISPLAY_NAME=ADFS
# Show a "Sign in with ADFS" button on the NEXORA sign-in page (set to the same alias)
NEXORA_ADFS_BUTTON_ALIAS=
NEXORA_ADFS_BUTTON_LABEL=Sign in with ADFS

# ---- Email ----
# Alerts and "shared with you" messages. The bundled Mailpit catches everything at http://localhost:8025.
# For real email, set your mail server here.
NEXORA_MAIL_ENABLED=true
NEXORA_SMTP_HOST=mailpit
NEXORA_SMTP_PORT=1025
NEXORA_SMTP_USER=
NEXORA_SMTP_PASSWORD=
NEXORA_SMTP_STARTTLS=false
NEXORA_MAIL_FROM=NEXORA <nexora@nexora.local>

# ---- Search ----
# OCR languages, main language first: eng, ron+eng, deu+eng, ... (installed: eng fra deu ita spa jpn ron)
NEXORA_OCR_LANGUAGES=eng
# Memory for OpenSearch and for reading documents
NEXORA_OPENSEARCH_HEAP=1g
NEXORA_TIKA_MEMORY=4g

# ---- Office editor ----
NEXORA_OFFICE_FRAME_ANCESTORS=localhost:*
