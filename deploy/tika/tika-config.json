{
  "server": {
    "host": "0.0.0.0",
    "port": 9998
  },
  "engines": {
    "tesseract": {
      "tesseract-ocr-parser": {
        "language": "${env:NEXORA_OCR_LANGUAGES}",
        "timeoutMillis": 120000
      }
    }
  },
  "text-recognizers": [
    { "engine": "tesseract" }
  ],
  "parse-context": {
    "timeout-limits": {
      "totalTaskTimeoutMillis": 600000,
      "progressTimeoutMillis": 180000
    }
  }
}
